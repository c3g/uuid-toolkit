# PostgreSQL connection used by the FastAPI backend.
# Replace these placeholders with the values for your environment.
DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/database_name

# Comma-separated frontend origins allowed to make cross-origin API requests.
# Local development example:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CILogon / OIDC configuration. Get these from whoever registered this
# app's CILogon client (client ID/secret are per-app, not shared with
# other C3G apps). OIDC_REDIRECT_URI must exactly match what was
# registered, including trailing slash.
OIDC_ISSUER=https://cilogon.org
OIDC_CLIENT_ID=replace-with-cilogon-client-id
OIDC_CLIENT_SECRET=replace-with-cilogon-client-secret
OIDC_REDIRECT_URI=http://localhost:8000/

# Secret key used to sign the app's session cookie. Generate a long random
# value for each environment; never reuse this placeholder or share it
# between environments.
SESSION_SECRET=replace-with-a-long-random-secret

# Set to "true" in production (HTTPS). Must stay "false" for local Podman
# testing over plain HTTP, or the session cookie will not be set.
SESSION_COOKIE_SECURE=false

# Set to "false" only for local `npm run dev` frontend iteration, where
# CILogon's registered redirect URI does not apply. Must stay "true" (or
# unset) everywhere else, including production.
AUTH_REQUIRED=true